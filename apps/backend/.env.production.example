# Medusa Backend - Production Environment Configuration
# Copy this file to .env on your GCP VM and update with your actual values

# ============================================
# DATABASE - Neon PostgreSQL
# ============================================
# Format: postgresql://username:password@host.neon.tech/dbname?sslmode=require
# Get this from your Neon dashboard
DATABASE_URL=postgresql://username:password@ep-xxx-xxx-xxx.neon.tech/neondb?sslmode=require

# ============================================
# REDIS
# ============================================
# For local Redis on GCP VM
REDIS_URL=redis://localhost:6379

# For managed Redis (if using)
# REDIS_URL=redis://username:password@redis-host:6379

# ============================================
# CORS CONFIGURATION
# ============================================
# Add your actual production domains
# Separate multiple domains with commas

# Store (customer-facing storefront)
STORE_CORS=https://yourdomain.com,https://www.yourdomain.com

# Admin panel
ADMIN_CORS=https://admin.yourdomain.com,https://yourdomain.com

# Auth endpoints
AUTH_CORS=https://admin.yourdomain.com,https://yourdomain.com,https://api.yourdomain.com

# ============================================
# SECURITY SECRETS
# ============================================
# ⚠️ IMPORTANT: Generate new secure values for production!
# Use the commands below to generate secure secrets:
# 
# JWT_SECRET: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# COOKIE_SECRET: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# AUTH_MFA_ENCRYPTION_KEY: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

JWT_SECRET=REPLACE_WITH_SECURE_JWT_SECRET_MIN_32_CHARS
COOKIE_SECRET=REPLACE_WITH_SECURE_COOKIE_SECRET_MIN_32_CHARS
AUTH_MFA_ENCRYPTION_KEY=REPLACE_WITH_64_CHAR_HEX_ENCRYPTION_KEY

# ============================================
# RAZORPAY PAYMENT PROVIDER
# ============================================
# ⚠️ Use PRODUCTION keys for live payments!

# Get these from Razorpay Dashboard (https://dashboard.razorpay.com)
RAZORPAY_KEY_ID=rzp_live_YOUR_LIVE_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_LIVE_KEY_SECRET
RAZORPAY_CURRENCY=INR

# Webhook secret (from Razorpay Dashboard > Webhooks)
RAZORPAY_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET

# ============================================
# APPLICATION CONFIGURATION
# ============================================
NODE_ENV=production
PORT=9000

# Admin onboarding
MEDUSA_ADMIN_ONBOARDING_TYPE=nextjs

# If using separate Next.js storefront
# MEDUSA_ADMIN_ONBOARDING_NEXTJS_DIRECTORY=../storefront

# ============================================
# OPTIONAL: EMAIL CONFIGURATION
# ============================================
# Configure SendGrid, Mailgun, or other email service
# SENDGRID_API_KEY=your_sendgrid_api_key
# SENDGRID_FROM=noreply@yourdomain.com

# ============================================
# OPTIONAL: FILE STORAGE
# ============================================
# For production, consider using cloud storage (S3, GCS, etc.)
# FILE_STORAGE_BUCKET=your-bucket-name
# FILE_STORAGE_ENDPOINT=https://storage.googleapis.com

# ============================================
# OPTIONAL: MONITORING & LOGGING
# ============================================
# LOG_LEVEL=info
# SENTRY_DSN=your_sentry_dsn

# ============================================
# NOTES
# ============================================
# 1. Never commit this file to version control
# 2. Keep backups of these secrets in a secure location
# 3. Rotate secrets periodically
# 4. Use environment-specific values (don't reuse dev secrets)
# 5. Ensure .env is in .gitignore
