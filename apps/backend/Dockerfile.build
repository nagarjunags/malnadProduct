# Dockerfile for building Medusa on Mac for Linux deployment
FROM node:20-slim

WORKDIR /app

# Install pnpm
RUN npm install -g pnpm@11.21.0

# Copy package files
COPY package.json pnpm-lock.yaml* ./

# Install dependencies
RUN pnpm install --frozen-lockfile

# Copy source code
COPY . .

# Build
RUN pnpm run build

# The output will be in .medusa/server
