{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm turbo build --filter=@dtc/storefront",
  "installCommand": "pnpm install --frozen-lockfile",
  "framework": "nextjs",
  "outputDirectory": "apps/storefront/.next",
  "ignoreCommand": "git diff HEAD^ HEAD --quiet . ':(exclude)apps/backend'"
}
